pkgname=kanji-trainer
pkgver=1.1.0
_kaizenver=1.0.0
pkgrel=1
pkgdesc="Practice JLPT vocabulary written in kanji: readings, meanings, pictures and audio"
arch=('x86_64')
url="https://github.com/arsalan-anwari/kanji-trainer"
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
options=('!debug' '!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "kaizen-ui-$_kaizenver.tar.gz::https://github.com/arsalan-anwari/kaizen-ui/archive/refs/tags/v$_kaizenver.tar.gz")
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  rm -rf vendor/kaizen-ui
  mkdir -p vendor
  cp -a "$srcdir/kaizen-ui-$_kaizenver" vendor/kaizen-ui
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  npm install
  npm run build
  cargo build --release --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 "src-tauri/target/release/kanji-trainer" "$pkgdir/usr/bin/kanji-trainer"
  install -Dm644 "packaging/linux/nl.anwari.kanjitrainer.desktop" "$pkgdir/usr/share/applications/nl.anwari.kanjitrainer.desktop"
  install -Dm644 "packaging/linux/nl.anwari.kanjitrainer.metainfo.xml" "$pkgdir/usr/share/metainfo/nl.anwari.kanjitrainer.metainfo.xml"
  install -Dm644 "src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/nl.anwari.kanjitrainer.png"
  install -Dm644 "src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/nl.anwari.kanjitrainer.png"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
