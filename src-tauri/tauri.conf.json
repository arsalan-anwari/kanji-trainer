{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanji Trainer",
  "version": "0.1.0",
  "identifier": "nl.anwari.kanjitrainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kanji Trainer",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f7f2e7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data: blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Kanji trainer",
    "longDescription": "Practice JLPT kanji by level and category: readings, written forms, and audio prompts."
  }
}
