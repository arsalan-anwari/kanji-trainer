{
  "name": "kanji-trainer",
  "version": "0.1.0",
  "description": "Cross-platform trainer for learning kanji by level and category",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "content:fetch": "node tools/content/fetch.ts",
    "content:build": "npm run content:fetch && node tools/content/build.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev -- --no-default-features",
    "tauri:build": "tauri build --no-bundle",
    "sync:ui": "git -C vendor/kaizen-ui push origin HEAD:main && git add vendor/kaizen-ui"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "kaizen-ui": "file:vendor/kaizen-ui"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.13.3",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "5.0.1"
  }
}
